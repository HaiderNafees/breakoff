# Copy to .env.local and fill in what you have. Everything is optional:
# without Stripe keys the checkout stays in demo mode and charges nothing.

# Stripe — test keys are fine. Secret key enables real card payments.
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
# From `stripe listen --forward-to localhost:3000/api/webhooks/stripe`
STRIPE_WEBHOOK_SECRET=

# Origin used for Stripe redirect URLs (set this in production)
SITE_URL=http://localhost:3000

# Merchant token for POST /api/admin/orders/<number>/status
ADMIN_TOKEN=

# Where accounts, sessions and orders are stored. Defaults to ./.data
BREAKOFF_DATA_DIR=

# Copy to .env.local and fill in what you have. Everything is optional:
# without Stripe keys the checkout stays in demo mode and charges nothing.

# Postgres for accounts, sessions and orders. Leave empty for local development
# and the app uses a JSON file in ./.data instead. On Vercel this is required —
# serverless functions cannot write files.
#   Supabase: Project Settings -> Database -> Connection pooling -> URI (port 6543)
#   Neon:     Dashboard -> Connect -> pooled connection string
DATABASE_URL=

# Stripe — test keys are fine. Secret key enables real card payments.
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
# From the Stripe dashboard webhook endpoint, or `stripe listen` locally
STRIPE_WEBHOOK_SECRET=

# Origin used for Stripe redirect URLs (set this to the production URL)
SITE_URL=http://localhost:3000

# Merchant token for POST /api/admin/orders/<number>/status
ADMIN_TOKEN=

# Where the local file store lives when DATABASE_URL is empty. Defaults to ./.data
BREAKOFF_DATA_DIR=
